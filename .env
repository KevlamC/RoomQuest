# In your ROOT directory (.env file)
# PostgreSQL Configuration
DATABASE_URL=postgresql://roomquest_user:roomquest_pass@localhost:5432/roomquest_db

# Flask Backend Secrets
JWT_SECRET_KEY=your_32_character_super_secret_key_here
FLASK_DEBUG=True  # Disable in production!

# Frontend API Base URL (for React)
VITE_API_BASE=http://localhost:5000